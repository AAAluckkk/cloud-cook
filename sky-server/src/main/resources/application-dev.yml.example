# 配置模板 —— 复制本文件为同目录下的 application-dev.yml，再填入真实值。
# application-dev.yml 已加入 .gitignore，不会被提交到仓库。
sky:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    host: localhost
    port: 3306
    database: sky_take_out
    username: root
    password: <你的数据库密码>
  redis:
    host: localhost
    port: 6379
    password: <你的 Redis 密码>
    database: 1
  wechat:
    # 微信小程序，用于用户端登录
    appid: <你的小程序 appid>
    secret: <你的小程序 secret>
  alioss:
    # 阿里云 OSS，用于图片上传
    endpoint: oss-cn-beijing.aliyuncs.com
    access-key-id: <你的 AccessKeyId>
    access-key-secret: <你的 AccessKeySecret>
    bucket-name: <你的 bucket 名>
